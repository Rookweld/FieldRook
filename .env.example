# FieldRook environment template. Copy to `.env` and fill in values.
# Never commit a real `.env` with credentials.

# Meta Model API key. When empty, FieldRook uses clearly labeled simulated analysis.
MODEL_API_KEY=

# Meta Model API configuration.
MODEL_BASE_URL=https://api.meta.ai/v1
MODEL_NAME=muse-spark-1.3

# Diagnostic data source: auto | always | never
# auto   = live Windows diagnostics when available, fixtures otherwise
# always = deterministic fixtures (demos, tests, non-Windows hosts)
# never  = live diagnostics only; report live errors without fixture fallback
FIELDROOK_FIXTURES=auto
